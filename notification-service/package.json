{
  "name": "notification-service",
  "version": "1.0.4",
  "description": "Pharma notification service for email and SMS alerts",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage --forceExit"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.13.4",
    "nodemailer": "^9.0.1",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.1",
    "qs": "^6.15.2",
    "body-parser": "^1.20.6"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "clover"
    ]
  }
}
